# ========================================
# Livlog Backend Environment Variables
# ========================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값으로 변경하세요.
# cp .env.example .env

# ========================================
# Application Settings
# ========================================
SPRING_APPLICATION_NAME=livlog
SERVER_PORT=8080

# ========================================
# JWT Settings
# ========================================
# JWT 시크릿 키 (최소 32자 이상, HS512 알고리즘 사용)
JWT_SECRET=your-very-long-and-secure-secret-key-must-be-at-least-32-characters-long-for-hs512-algorithm
JWT_ISSUER=livlog-backend

# JWT 토큰 유효기간 (밀리초)
JWT_ACCESS_TOKEN_EXPIRATION=3600000   # 1시간
JWT_REFRESH_TOKEN_EXPIRATION=86400000 # 24시간

# ========================================
# Database Settings (H2 - Development)
# ========================================
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:mem:testdb
DB_USERNAME=sa
DB_PASSWORD=

# H2 Console
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# ========================================
# Database Settings (PostgreSQL - Production)
# ========================================
# 프로덕션 환경에서는 아래 설정 사용
# DB_DRIVER=org.postgresql.Driver
# DB_URL=jdbc:postgresql://localhost:5432/livlog
# DB_USERNAME=postgres
# DB_PASSWORD=your-database-password

# ========================================
# Database Settings (MySQL - Production)
# ========================================
# 또는 MySQL 사용 시
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_URL=jdbc:mysql://localhost:3306/livlog?useSSL=false&serverTimezone=Asia/Seoul
# DB_USERNAME=root
# DB_PASSWORD=your-database-password

# ========================================
# JPA/Hibernate Settings
# ========================================
JPA_DDL_AUTO=create-drop  # 개발: create-drop, 프로덕션: validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_USE_SQL_COMMENTS=true

# ========================================
# OAuth2 - Google
# ========================================
OAUTH2_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH2_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ========================================
# OAuth2 - GitHub
# ========================================
OAUTH2_GITHUB_CLIENT_ID=your-github-client-id
OAUTH2_GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH2_GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# ========================================
# OAuth2 - Kakao
# ========================================
OAUTH2_KAKAO_CLIENT_ID=your-kakao-client-id
OAUTH2_KAKAO_CLIENT_SECRET=your-kakao-client-secret
OAUTH2_KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# ========================================
# OAuth2 - Naver
# ========================================
OAUTH2_NAVER_CLIENT_ID=your-naver-client-id
OAUTH2_NAVER_CLIENT_SECRET=your-naver-client-secret
OAUTH2_NAVER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/naver

# ========================================
# OAuth2 - Facebook
# ========================================
OAUTH2_FACEBOOK_CLIENT_ID=your-facebook-client-id
OAUTH2_FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
OAUTH2_FACEBOOK_REDIRECT_URI=http://localhost:8080/login/oauth2/code/facebook

# ========================================
# File Upload Settings
# ========================================
FILE_UPLOAD_DIR=uploads/
FILE_MAX_SIZE=10485760          # 10MB in bytes
FILE_MAX_REQUEST_SIZE=10485760  # 10MB in bytes

# ========================================
# Logging Settings
# ========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_LOGLAB_LIVLOG=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG
LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG

# ========================================
# CORS Settings
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ========================================
# Email Settings (선택사항)
# ========================================
# 이메일 인증 기능 추가 시 사용
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_PROTOCOL=smtp
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true

# ========================================
# Redis Settings (선택사항)
# ========================================
# 리프레시 토큰 저장 또는 캐싱용
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================================
# AWS S3 Settings (선택사항)
# ========================================
# 파일 업로드를 S3로 전환 시 사용
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET_NAME=livlog-media

# ========================================
# Monitoring & Observability (선택사항)
# ========================================
# ACTUATOR_ENDPOINTS_ENABLED=true
# ACTUATOR_EXPOSURE_INCLUDE=health,info,metrics

# ========================================
# Profile
# ========================================
# 활성 프로파일 (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
